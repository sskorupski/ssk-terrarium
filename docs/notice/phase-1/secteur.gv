	CORDON [label=<
<table border="0" cellspacing="0" cellpadding="0">
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1"><tr>
   <td balign="left">CORDON</td>
  </tr></table>
 </td></tr>
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1"><tr>
   <td balign="left">(N) Cordon secteur 3G 1 mm² avec fiche</td>
   <td balign="left">3-pin</td>
  </tr></table>
 </td></tr>
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1">
   <tr>
    <td>Phase</td>
    <td port="p1r">1</td>
   </tr>
   <tr>
    <td>Neutre</td>
    <td port="p2r">2</td>
   </tr>
   <tr>
    <td>Terre</td>

	KS5016 [label=<
<table border="0" cellspacing="0" cellpadding="0">
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1"><tr>
   <td balign="left">KS5016</td>
  </tr></table>
 </td></tr>
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1"><tr>
   <td balign="left">(A) Carte Keyestudio KS5016</td>
   <td balign="left">3,3 V et GND : colonnes V et G du bloc ANALOG</td>
   <td balign="left">6-pin</td>
  </tr></table>
 </td></tr>
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1">
   <tr>
    <td>GPIO 21 (SDA)</td>
    <td port="p1r">1</td>
   </tr>
   <tr>
    <td>GPIO 22 (SCL)</td>
    <td port="p2r">2</td>
   </tr>
   <tr>
    <td>GPIO 4</td>
    <td port="p3r">3</td>
   </tr>
   <tr>
    <td>Rangée 3,3 V</td>
    <td port="p4r">4</td>
   </tr>
   <tr>
    <td>Rangée GND</td>
    <td port="p5r">5</td>
   </tr>
   <tr>
    <td>GPIO 13</td>
    <td port="p6r">6</td>
   </tr>
  </table>
 </td></tr>
</table>
